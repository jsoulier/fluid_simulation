#include "config.h"

cbuffer UniformBuffer : register(b0, space2)
{
    float3 CameraPosition;
    float TanHalfFov;
    float3 CameraRight;
    float Aspect;
    float3 CameraUp;
    uint ObjectCount;
    float3 CameraForward;
    float DiskR1;
    float DiskR2;
    uint FrameCount;
    uint ResetAccumulation;
};

// Planar integration remains the foundation for stable, glitch-free geodesics.
struct Ray
{
    float3 Position;
    float3 U; // 2D Plane Basis X
    float3 W; // 2D Plane Basis Y
    float R;
    float Phi;
    float Dr;
    float E;
    float L;
};

struct Object
{
    float3 Position;
    float Radius;
    float3 Color;
    float Mass;
};

[[vk::image_format("rgba8")]]
RWTexture2D<float4> outImage : register(u0, space1);
[[vk::image_format("rgba32f")]]
RWTexture2D<float4> accumulationBuffer : register(u1, space1);
StructuredBuffer<Object> objects : register(t0, space0);

static const float kBlackHoleRadius = 1.269e10f;
static const float kMinStep = 1.0e6f;
static const int kMaxSteps = 5000;
static const float kEscape = 1.0e14f; 

float Hash(float3 p, float seed)
{
    p = frac(p * 0.3183099f + seed);
    p *= 17.0f;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float GetSceneSDF(float3 pos)
{
    float d = length(pos) - kBlackHoleRadius;
    for (uint i = 0; i < ObjectCount; i++)
    {
        if (length(objects[i].Position) < 1.0f) 
        {
            continue;
        }
        d = min(d, distance(pos, objects[i].Position) - objects[i].Radius);
    }
    return d;
}

Ray CreateRay(float3 position, float3 direction)
{
    Ray ray;
    ray.R = length(position);
    ray.Phi = 0.0f;
    ray.U = position / ray.R;
    
    float3 N = cross(ray.U, direction);
    float nLen = length(N);
    if (nLen < 1e-6f)
    {
        float3 axis = abs(ray.U.y) < 0.9f ? float3(0,1,0) : float3(1,0,0);
        ray.W = normalize(cross(ray.U, axis));
    }
    else
    {
        ray.W = normalize(cross(N, ray.U));
    }
    
    ray.Dr = dot(direction, ray.U);
    float Dphi = dot(direction, ray.W) / ray.R;
    ray.L = ray.R * ray.R * Dphi;
    
    float f = 1.0f - kBlackHoleRadius / ray.R;
    float dl = sqrt(max(0.0f, (ray.Dr * ray.Dr) / f + ray.R * ray.R * (Dphi * Dphi)));
    ray.E = f * dl;
    
    ray.Position = position;
    return ray;
}

void Step(inout Ray ray, float dt)
{
    float r = ray.R;
    float dr = ray.Dr;
    float f = 1.0f - kBlackHoleRadius / r;
    
    float d2r = -(kBlackHoleRadius / (2.0f * r * r * f)) * (ray.E * ray.E / f - dr * dr) + (ray.L * ray.L / (r * r * r));
    
    ray.R += dt * dr;
    ray.Phi += dt * (ray.L / (r * r));
    ray.Dr += dt * d2r;
    
    ray.Position = ray.R * (cos(ray.Phi) * ray.U + sin(ray.Phi) * ray.W);
}

[numthreads(THREADS, THREADS, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= WIDTH || id.y >= HEIGHT)
    {
        return;
    }

    // Jitter for sub-pixel anti-aliasing
    float seed = (float)FrameCount * 0.0113f;
    float3 pixelSeed = float3((float)id.x, (float)id.y, seed);
    float jitterX = Hash(pixelSeed, 0.1f) - 0.5f;
    float jitterY = Hash(pixelSeed, 0.2f) - 0.5f;

    float u = (2.0f * (id.x + 0.5f + jitterX) / WIDTH - 1.0f) * Aspect * TanHalfFov;
    float v = (1.0f - 2.0f * (id.y + 0.5f + jitterY) / HEIGHT) * TanHalfFov;
    float3 direction = normalize(u * CameraRight - v * CameraUp + CameraForward);
    
    Ray ray = CreateRay(CameraPosition, direction);
    float3 resultColor = float3(0, 0, 0);
    bool hit = false;

    for (int i = 0; i < kMaxSteps; i++)
    {
        if (ray.R <= kBlackHoleRadius)
        {
            resultColor = float3(0, 0, 0);
            hit = true;
            break;
        }

        float3 prevPos = ray.Position;
        float sdf = GetSceneSDF(ray.Position);
        float f = 1.0f - kBlackHoleRadius / ray.R;
        float dl = ray.E / f;
        float dt = max(kMinStep, min(sdf * 0.5f, ray.R * 0.1f) / dl);
        
        Step(ray, dt);

        for (uint j = 0; j < ObjectCount; j++)
        {
            float d = distance(ray.Position, objects[j].Position) - objects[j].Radius;
            if (d <= 0.0f)
            {
                float3 N = normalize(ray.Position - objects[j].Position);
                float3 V = normalize(CameraPosition - ray.Position);
                float intensity = 0.1f + 0.9f * max(dot(N, V), 0.0f);
                resultColor = objects[j].Color * intensity;
                hit = true;
                break;
            }
        }
        if (hit)
        {
            break;
        }

        if (prevPos.y * ray.Position.y < 0.0f)
        {
            float t = abs(prevPos.y) / (abs(prevPos.y) + abs(ray.Position.y));
            float3 intersectPos = lerp(prevPos, ray.Position, t);
            float diskR = length(float2(intersectPos.x, intersectPos.z));
            
            if (diskR >= DiskR1 && diskR <= DiskR2)
            {
                float rNorm = diskR / DiskR2;
                resultColor = float3(1.0f, rNorm, 0.2f) * rNorm;
                hit = true;
                break;
            }
        }

        if (ray.R > kEscape)
        {
            break;
        }
    }
    
    if (!hit)
    {
        float3 finalDir = normalize(ray.Position);
        float starHash = Hash(floor(finalDir * 500.0f), 0.0f);
        if (starHash > 0.998f)
        {
            resultColor = float3(1.0f, 1.0f, 1.0f);
        }
        else
        {
            resultColor = float3(0.02f, 0.02f, 0.02f);
        }
    }

    // Weighted Accumulation
    float4 prevAccum = accumulationBuffer[id.xy];
    if (ResetAccumulation != 0)
    {
        prevAccum = float4(0, 0, 0, 0);
    }
    
    float sampleCount = prevAccum.a + 1.0f;
    float3 finalColor = lerp(prevAccum.rgb, resultColor, 1.0f / sampleCount);
    
    accumulationBuffer[id.xy] = float4(finalColor, sampleCount);
    outImage[id.xy] = float4(finalColor, 1.0f);
}
