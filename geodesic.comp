struct Object
{
    float3 Position;
    float Radius;
    float3 Color;
    float Mass;
};

[[vk::image_format("rgba8")]]
RWTexture2D<float4> outImage : register(u0, space1);
[[vk::image_format("rgba32f")]]
RWTexture2D<float4> accumulationBuffer : register(u1, space1);
StructuredBuffer<Object> objects : register(t0, space0);

static const float kBlackHoleRadius = 1.269e10f;
static const float kMinStep = 1.0e6f;
static const int kMaxSteps = 5000;
static const float kEscape = 1.0e14f; 

float Hash(float3 position, float seed)
{
    position = frac(position * 0.3183099f + seed);
    position *= 17.0f;
    return frac(position.x * position.y * position.z * (position.x + position.y + position.z));
}

Ray CreateRay(float3 position, float3 direction)
{
    Ray ray;
    ray.R = length(position);
    ray.Phi = 0.0f;
    ray.U = position / ray.R;
    float3 N = cross(ray.U, direction);
    if (length(N) < 1e-6f)
    {
        float3 axis = abs(ray.U.y) < 0.9f ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);
        ray.W = normalize(cross(ray.U, axis));
    }
    else
    {
        ray.W = normalize(cross(N, ray.U));
    }
    ray.Dr = dot(direction, ray.U);
    float Dphi = dot(direction, ray.W) / ray.R;
    ray.L = ray.R * ray.R * Dphi;
    float f = 1.0f - kBlackHoleRadius / ray.R;
    float dl = sqrt(max(0.0f, (ray.Dr * ray.Dr) / f + ray.R * ray.R * (Dphi * Dphi)));
    ray.E = f * dl;
    ray.Position = position;
    return ray;
}

