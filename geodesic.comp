#include "config.h"

cbuffer UniformBuffer : register(b0, space2)
{
    float3 CameraPosition;
    float TanHalfFov;
    float3 CameraRight;
    float Aspect;
    float3 CameraUp;
    uint ObjectCount;
    float3 CameraForward;
    float DiskR1;
    float DiskR2;
};

// =========================================================================
// NEW APPROACH: PLANAR GEODESIC INTEGRATION
// =========================================================================
// Instead of tracking 3D spherical coordinates (theta, phi), we exploit
// the fact that every light ray in Schwarzschild space stays on a 2D plane.
// This removes "polar singularities" (the quasar glitch) and improves speed.
struct Ray
{
    float3 Position;
    float3 U; // 2D Plane Basis X-axis
    float3 W; // 2D Plane Basis Y-axis
    float R;  // Radial distance from center
    float Phi; // Angle within the custom 2D plane
    float Dr;  // Radial velocity
    float E;   // Energy (Conserved)
    float L;   // Angular Momentum (Conserved)
};

/* 
// =========================================================================
// ORIGINAL APPROACH (Commented out for reference)
// =========================================================================
// This used 3D Spherical coordinates. It suffered from glitches at the
// poles because dividing by sin(theta) becomes unstable near the Z-axis.
struct Ray_Original
{
    float3 Position;
    float R;
    float Theta;
    float Phi;
    float Dr;
    float Dtheta;
    float Dphi;
    float E;
    float L;
};
*/

struct Object
{
    float3 Position;
    float Radius;
    float3 Color;
    float Mass;
};

[[vk::image_format("rgba8")]]
RWTexture2D<float4> outImage : register(u0, space1);
StructuredBuffer<Object> objects : register(t0, space0);

static const float kBlackHoleRadius = 1.269e10f;
static const float kMinStep = 1.0e6f;
static const int kMaxSteps = 5000;
static const float kEscape = 1.0e14f; 

float Hash(float3 p)
{
    p = frac(p * 0.3183099f + 0.1f);
    p *= 17.0f;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float GetSceneSDF(float3 pos)
{
    float d = length(pos) - kBlackHoleRadius;
    for (uint i = 0; i < ObjectCount; i++)
    {
        if (length(objects[i].Position) < 1.0f) 
        {
            continue;
        }
        d = min(d, distance(pos, objects[i].Position) - objects[i].Radius);
    }
    return d;
}

// Every light ray is trapped on a 2D sheet (Plane).
// We find that sheet's X (U) and Y (W) axes here.
Ray CreateRay(float3 position, float3 direction)
{
    Ray ray;
    ray.R = length(position);
    ray.Phi = 0.0f;
    ray.U = position / ray.R; // The "X-axis" of our local plane
    
    // N is the vector perpendicular to the plane
    float3 N = cross(ray.U, direction);
    float nLen = length(N);
    
    if (nLen < 1e-6f)
    {
        // Handle purely radial rays
        float3 axis = abs(ray.U.y) < 0.9f ? float3(0, 1, 0) : float3(1, 0, 0);
        ray.W = normalize(cross(ray.U, axis));
    }
    else
    {
        // W is the "Y-axis" of our local plane
        ray.W = normalize(cross(N, ray.U));
    }
    
    // Project 3D velocity into our 2D plane coordinates
    ray.Dr = dot(direction, ray.U);
    float Dphi = dot(direction, ray.W) / ray.R;
    ray.L = ray.R * ray.R * Dphi;
    
    float f = 1.0f - kBlackHoleRadius / ray.R;
    float dl = sqrt(max(0.0f, (ray.Dr * ray.Dr) / f + ray.R * ray.R * (Dphi * Dphi)));
    ray.E = f * dl;
    
    ray.Position = position;
    return ray;
}

// Planar math: solves for R and Phi only. No poles, no singularities.
void Step(inout Ray ray, float dt)
{
    float r = ray.R;
    float dr = ray.Dr;
    float f = 1.0f - kBlackHoleRadius / r;
    
    // Schwarzschild equations of motion in 2D
    float d2r = -(kBlackHoleRadius / (2.0f * r * r * f)) * (ray.E * ray.E / f - dr * dr) + (ray.L * ray.L / (r * r * r));
    
    ray.R += dt * dr;
    ray.Phi += dt * (ray.L / (r * r));
    ray.Dr += dt * d2r;
    
    // Reconstruct 3D Position by rotating the U vector by Phi on the plane
    ray.Position = ray.R * (cos(ray.Phi) * ray.U + sin(ray.Phi) * ray.W);
}

