// Modified to use planar geodesic integration

#include "config.h"

cbuffer UniformBuffer : register(b0, space2)
{
    float3 CameraPosition;
    float TanHalfFov;
    float3 CameraRight;
    float Aspect;
    float3 CameraUp;
    uint ObjectCount;
    float3 CameraForward;
    float DiskR1;
    float DiskR2;
    uint FrameCount;
    uint ResetAccumulation;
};

struct Ray
{
    float3 Position;
    float3 U;
    float3 W;
    float R;
    float Phi;
    float Dr;
    float E;
    float L;
};

